NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Leave DATABASE_URL empty to run the API in demo mode (read-only seed catalog).
DATABASE_URL=

# Required for the admin panel. Generate with: openssl rand -base64 48
JWT_SECRET=

# Required for member registration and sign-in bot verification.
# The secret key stays in the API environment only.
TURNSTILE_SECRET_KEY=
# Exact public storefront hostname, for example: www.purepeptide.us
TURNSTILE_EXPECTED_HOSTNAME=

# Contact-form delivery (optional — messages still persist without it)
RESEND_API_KEY=
OWNER_EMAIL=

# Used only by `npm run db:seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
